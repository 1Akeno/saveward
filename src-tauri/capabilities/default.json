{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the backup pop-up",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "opener:default",
    "dialog:default"
  ]
}
